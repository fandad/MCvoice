{
  "schemaVersion": 1,
  "id": "mcvoice",
  "version": "${version}",
  "name": "MC语音",
  "description": "在聊天框输入文字，本地生成中文语音；通过 Simple Voice Chat 或 Plasmo Voice 让服务器里的其他玩家听到。",
  "authors": [
    "MCvoice"
  ],
  "license": "GPL-3.0-only",
  "icon": "assets/mcvoice/textures/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mcvoice.ttvoice.plasmo.McvoicePvCommon"
    ],
    "client": [
      "com.mcvoice.ttvoice.TtVoiceClient"
    ],
    "voicechat": [
      "com.mcvoice.ttvoice.VcPlugin"
    ],
    "modmenu": [
      "com.mcvoice.ttvoice.ModMenuEntry"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.1 <26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": ">=18.0.0",
    "voicechat": ">=2.6.22+26.1.2",
    "plasmovoice": "*",
    "pv-addon-groups": "*"
  }
}
